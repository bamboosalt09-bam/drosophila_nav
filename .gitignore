.venv/
__pycache__/
*.pyc
.pytest_cache/
results/**/*.png
results/**/*.gif
data/

# build products (rebuild with build_cpp.bat)
build/
*.pyd

# regenerable caches: training clips (experiments/collect_clips.py) and
# subnet pickles (src/core/subnet_file.py rebuilds them on first use)
results/clips/
results/subnet/*.pkl

# ...except the sweep figures: they are the record the user reads
!results/sweep_*.png

# live viewer snapshot (cx_vp_room.py --live)
results/live.json
results/live.json.tmp

# committed on purpose, so a fresh clone runs without the 2 GB connectome or MSVC:
!src/sensors/_fisheye_cpp/_fisheye.cp313-win_amd64.pyd
!src/sensors/_fisheye_cpp/_fisheye.cpython-313-x86_64-linux-gnu.so
!results/subnet/vp_h4_rho0.50_ol_intrinsic.pkl
